# ===== 必填 =====
# PostgreSQL 连接串（Neon / Supabase / Railway / 自建均可）。云数据库通常需要在末尾加 ?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 后台管理员密码（至少 8 位，建议 16 位以上随机字符串）。未设置时后台会被禁用。
ADMIN_PASSWORD=change-me-to-a-long-random-password

# ===== 推荐 =====
# 会话签名密钥（至少 16 位，建议 `openssl rand -hex 32` 生成）。不设置时由 ADMIN_PASSWORD 派生。
SESSION_SECRET=

# ===== 可选 =====
# 站点公开地址（用于 sitemap / 分享预览）。不设置时按访问域名自动推断。
NEXT_PUBLIC_SITE_URL=
